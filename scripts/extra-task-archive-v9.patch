+def _decision(task, member, symbol_counts, archived, ready_dates):
+    request = task['request']
+    if member is None or request.get('symbol') != member['symbol']:
+        return 'target_identity_mismatch', None
+    if symbol_counts[member['symbol']] != 1:
+        return 'target_symbol_not_unique', None

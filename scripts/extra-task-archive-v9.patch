+def _current_master_reason(member, current):
+    symbols, status = current
+    if not status or any(state != 'verified' for state in status.values()):
+        return 'current_master_incomplete'
+    if member is None:
+        return 'target_identity_unavailable'
+    symbol = member['symbol']
+    if matches := symbols.get(symbol):
+        return 'unique_current_exact_match' if len(matches) == 1 else 'ambiguous_current_exact_match'
+    try:
+        alias = directory_cqs_symbol(member)
+    except ValueError:
+        alias = symbol
+    if alias != symbol and (matches := symbols.get(alias)):
+        return 'unique_current_official_cqs_match' if len(matches) == 1 else 'ambiguous_current_official_cqs_match'
+    return 'no_current_exact_or_official_cqs_match'
+
+
+def _proofs(member, rows):
+    proofs = []
+    routes = set()
+    for row in rows:
+        fields = row['fields'] or {}
+        if fields.get('provider_symbol') == member['symbol'] and fields.get('exchange') in US_VENUES:

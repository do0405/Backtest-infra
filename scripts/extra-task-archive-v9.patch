+        for task in tasks:
+            if task['source'] == 'kis_overseas' and task['entity_id'] in affected and _provider_route(task) is not None:
+                equivalents[_work_key(task, task['request'])].append(task)
+        new_tasks, replaced, retired = [], {}, set()
+        for task, proof in pending_repairs:
+            request = dict(task['request'], mapping_status='qualified', mapping_evidence=proof,

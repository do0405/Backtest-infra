+def audit_us_coverage(gh, repo, releases, configuration, catalog, work, *, key, restore_task_state):
+    if os.environ.get('GITHUB_EVENT_NAME') != 'workflow_dispatch':
+        raise ValueError('read-only manual audit required')
+    stream = configuration['owner_id']
+    release = next(row for row in releases if row['tag_name'] == BASELINE)
+    root = work/'coverage-audit'
+    commit = download_asset(gh, repo, release, 'commit.json', root/'previous', max_bytes=1024**2)
+    prior = read_encrypted_commit(commit, stream=stream, bootstrap_hash=configuration['bootstrap']['sha256'], tag=BASELINE)
+    asset = download_asset(gh, repo, release, 'state.json.gz.enc', root/'previous',
+                           max_bytes=MAX_PRIVATE_ASSET+HEADER.size+16)
+    clear = decrypt_file(asset, root/'state.json.gz', key=key,
+                         binding=f"{stream}:{prior['start_sequence']}:state.json.gz",
+                         record=prior['files']['state.json.gz.enc'])
+    checkpoint = read_state(clear)
+    if (checkpoint.get('task_archive_assets') is None or checkpoint.get('handoff_id') != configuration['handoff_id']
+            or checkpoint.get('forward_start') != configuration['forward_start']):
+        raise ValueError('owned external task archive required')
+    checkpoint, _ = restore_task_state(gh, repo, releases, configuration, prior, checkpoint, root, key=key)
+    windows, reasons = defaultdict(Counter), Counter()
+    for task in checkpoint['task_state']:
+        status, source, request = task['status'], task['source'], task['request']
+        if status not in UNFINISHED:
+            continue
+        reason = task['checkpoint'].get('reason') or request.get('mapping_reason') or 'none'
+        reason = reason if reason in {'none', 'restored_exact_master_mapping_unavailable', 'source_response_or_pagination_gap',
+                                      'source_no_data', 'source_row_validation_gap', 'source_pagination_did_not_progress',
+                                      'source_no_data_or_validation_gap', 'api_traversal_complete_recent_interval_deferred',
+                                      'exact_master_mapping_unavailable', 'kis_overseas_mapping_unavailable',
+                                      '403', '429', '503', 'empty', 'budget_deferred', 'provider_error'} else 'other'
+        if reason == 'none' and status == 'retry' and task['checkpoint'].get('cursor_end'):
+            reason = 'pagination_cursor_saved'
+        lane = request.get('cadence_lane')
+        lane = lane if lane in {'daily_latest','daily_catchup','weekly_correction'} else 'legacy'
+        reasons[source, status, lane, reason] += 1
+        if (source == 'kis_overseas' and task['domain'] == 'prices' and request.get('market') == 'US'
+                and _provider_route(task) is None and task['entity_id'] in catalog['members']):
+            start, end = (date.fromisoformat(request[field]) for field in ('output_start', 'output_end'))
+            windows[task['entity_id']][start, end] += 1
+    members = {identity: catalog['members'][identity] for identity in windows}
+    del checkpoint
+    windows = {identity: [(start, end, count) for (start, end), count in rows.items()] for identity, rows in windows.items()}
+    print(json.dumps({'status':'us_coverage_queue_reasons', 'sequence':prior['end_sequence'],
+                      'unfinished':sum(reasons.values()), 'queue':[[*labels,count] for labels,count in sorted(reasons.items())],
+                      'cohort_securities':len(members), 'cohort_requests':sum(sum(r[2] for r in ranges) for ranges in windows.values())}),
+          flush=True)
+    classes = listing_status(members)
+    events = matching_events(members)
+    classes.update({identity: event[1] for identity, event in events.items()})
+    exchanges = Counter(members[identity]['venue'] for identity, reason in classes.items()
+                        if reason == 'listed_same_code_missing_from_kis_master')
+    print(json.dumps({'status':'us_coverage_listing_audit', 'listing_counts':Counter(classes.values()),
+                      'listed_without_kis_by_exchange':exchanges,
+                      'official_notice_refs':sorted({event[3] for event in events.values()})}), flush=True)
+    history, meta = nasdaq_status_history(members, classes)
+    counts = Counter(kind for kind in classes.values())
+    for identity, (kind, effective) in history.items():
+        counts[classes[identity]] -= 1
+        classes[identity] = kind
+        counts[kind] += 1
+    print(json.dumps({'status':'us_coverage_lifecycle_history','updated_counts':dict(+counts),**meta}),flush=True)
+    for identity, (kind, effective) in history.items():
+        events[identity] = (members[identity]['name'], kind, effective-timedelta(days=1), 'nasdaq-security-status-updates')
+    verified_listing = {identity for identity, reason in classes.items()
+                        if reason.startswith(('listed_', 'official_'))}
+    coverage = existing_alpaca_coverage(configuration['manifest_id'], members, windows, verified_listing, events)
+    print(json.dumps({'status':'alpaca_followup_result', **coverage}), flush=True)

+    rows = archived.get(member['identifier'], ())
+    if not rows:
+        return 'no_archived_master_record', None
+    routes, proofs = _proofs(member, rows)
+    if len(routes) > 1:
+        return 'conflicting_catalog_routes', None
+    if not proofs:
+        return 'archived_master_not_qualified', None
+    prior = [proof for day, _, proof in proofs if day <= dates[0]]
+    if not prior:

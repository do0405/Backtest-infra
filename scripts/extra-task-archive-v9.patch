+def read(url, limit):
+    with urlopen(url, timeout=35) as response:
+        payload = response.read(limit + 1)
+    if len(payload) > limit:
+        raise ValueError('public evidence exceeds read bound')
+    return payload
+
+
+def _name(value):
+    return ' '.join(value.casefold().split())
+
+
+def _aliases(symbol, fields):
+    return {value for value in (symbol, fields.get('ACT Symbol'), fields.get('CQS Symbol'),
+                                 fields.get('NASDAQ Symbol')) if value}
+
+
+def matching_events(members):
+    result = {}
+    for identity, member in members.items():
+        event = NASDAQ_EVENTS.get(member['symbol'])
+        if not event or member['venue'] != 'NASDAQ':
+            continue
+        issuer = member['name'].split(' - ', 1)[0]
+        if _name(issuer) == _name(event[0]):
+            result[identity] = event
+    return result
+
+
+def listing_status(members):
+    current = defaultdict(list)
+    try:
+        for directory, url in DIRECTORIES.items():
+            payload = read(url, 4*1024**2)
+            if b'File Creation Time' not in payload[-256:]:
+                raise ValueError('complete official directory footer required')
+            for row in parse_us_directory(payload, directory):
+                for alias in _aliases(row.symbol, row.evidence):
+                    current[alias].append(row)
+    except (OSError, ValueError, UnicodeError):
+        return {identity: 'official_directory_unavailable' for identity in members}
+    result = {}
+    for identity, member in members.items():
+        aliases = _aliases(member['symbol'], member.get('evidence') or {})
+        candidates = {row.identifier: row for alias in aliases for row in current.get(alias, ())}
+        matches = [row for row in candidates.values() if row.venue == member['venue']
+                   and _name(row.name) == _name(member['name'])]
+        if len(matches) != 1:
+            result[identity] = 'listing_identity_conflict' if candidates else 'no_current_listing_match'
+        elif matches[0].symbol == member['symbol']:
+            result[identity] = 'listed_same_code_missing_from_kis_master'
+        else:
+            result[identity] = 'listed_official_code_alias'
+    return result
+

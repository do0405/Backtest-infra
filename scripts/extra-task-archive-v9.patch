+def run_price_slots(collector, engine, raw_root, slots, *, budget_seconds, as_of, hard_deadline, history_ids):
+    """Give each source its latest-price turn before running any historical lane."""
+    deadline = min(time.monotonic() + budget_seconds, hard_deadline)
+    per_source = budget_seconds / len(slots)
+    outcomes = []
+    unused_latest = Counter()
+    for lane, share in price_execution_shares(per_source):
+        for slot in slots:
+            source = slot['source']
+            started = time.monotonic()
+            if started >= deadline:
+                return outcomes
+            allowance = min(share + (unused_latest[source] if lane == 'history' else 0), deadline - started)
+            result = collector(engine, raw_root, market=slot['market'], domain=slot['domain'],
+                budget_seconds=allowance, mode='incremental', source_filter=[source],
+                request_lane=lane, request_day=price_ready_date(source, as_of),
+                prepare_queue=lane == 'latest', execution_deadline=deadline,
+                **({'request_ids': history_ids[source]} if lane == 'history' and source in history_ids else {}))
+            outcomes.append({**result, 'lane': lane, 'lane_source': source})

+def read_mapping_catalog(paths, manifest_id):
+    members = None
+    observations = defaultdict(list)
+    for path in paths:
+        for row in iter_bundle_rows(path):
+            values = row['values']
+            if row['table'] == 'target_universe_manifest' and values['id'] == manifest_id:
+                members = {member['security_id']: member for member in values['members'] if member['market'] == 'US'}
+            if row['table'] == 'catalog_observation' and values['source'] == 'kis_overseas_master':
+                observations[values['identifier']].append(values)
+    if members is None:
+        raise ValueError('owned US target manifest required for mapping audit')
+    return {'members': members, 'observations': observations}

+    return (task['status'] in WAITING or (task['status'] == 'succeeded'
+            and checkpoint.get('response_valid') is True and checkpoint.get('pagination_valid') is True))
+
+
+def audit_and_repair_us_mappings(checkpoint, catalog, *, ready_dates, apply=False, current=None):

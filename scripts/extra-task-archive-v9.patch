+MAPPING_FAILURES = {'restored_exact_master_mapping_unavailable', 'exact_master_mapping_unavailable',
+                    'kis_overseas_mapping_unavailable', 'kis_overseas_master_incomplete',
+                    'kis_overseas_mapping_ambiguous'}

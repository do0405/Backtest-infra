+def current_master_symbols():
+    """Read the official directories for diagnostics; these observations do not backdate routes."""
+    def read(directory):
+        exchange, url = directory
+        try:
+            with urlopen(url, timeout=15) as response:
+                content = response.read(MAX_MASTER_BYTES + 1)
+            return exchange, parse_kis_overseas_master(content, exchange)
+        except (OSError, ValueError):
+            return exchange, None
+
+    symbols = defaultdict(set)
+    status = {}
+    with ThreadPoolExecutor(max_workers=len(MASTER_DIRECTORIES)) as pool:
+        for exchange, rows in pool.map(read, MASTER_DIRECTORIES):
+            status[exchange] = 'verified' if rows else 'unavailable'
+            for row in rows or ():
+                symbols[row.provider_symbol].add(exchange)
+    return symbols, status

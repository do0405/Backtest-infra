+"""Conservative reconciliation for owned one-session KIS collection tasks."""
+
+from collections import defaultdict
+from datetime import date
+
+from ..ingestion.jobs import logical_request, stable_hash
+
+
+MARKET_BY_SOURCE = {'kis': 'KR', 'kis_overseas': 'US'}
+WAITING = ('pending', 'retry')
+UNFINISHED = (*WAITING, 'failed', 'unsupported')
+DAILY_LANES = {'daily_latest', 'daily_catchup'}
+US_VENUES = {'NAS', 'NYS', 'AMS'}
+# Positive full-day closure evidence for the 2026 forward window. Dates
+# outside these lists are never presumed closed merely for lack of a row.
+# KRX: https://open.krx.co.kr/contents/MKD/01/0110/01100305/MKD01100305.jsp
+# NYSE (including American) and Nasdaq:
+# https://www.nyse.com/trade/hours-calendars
+# https://nasdaqtrader.com/Trader.aspx?id=Calendar
+CONFIRMED_HOLIDAYS = {
+    'KR': {date(2026, 10, 9), date(2026, 12, 25), date(2026, 12, 31)},
+    'US': {date(2026, 11, 26), date(2026, 12, 25)},
+}
+
+
+def market_closed(market, day):
+    return day.weekday() >= 5 or day in CONFIRMED_HOLIDAYS[market]
+
+
+def daily_request_identity(task):
+    request = logical_request(task['request'])
+    lane = request.get('cadence_lane')
+    # Latest and catch-up change scheduling only. Keep all provider fields.
+    if lane in DAILY_LANES and request.get('refresh_policy') == f'extra_{lane}_v6':
+        del request['cadence_lane'], request['refresh_policy']
+    return stable_hash([task['source'], task['domain'], task['entity_id'], request])
+
+
+def unstarted(task):
+    return task['status'] == 'pending' and task.get('attempts') == 0 and not task['checkpoint']
+
+
+def _request_key(task, *, include_legacy=False):
+    source = task['source']
+    request = task['request']
+    market = MARKET_BY_SOURCE.get(source)
+    lane = request.get('cadence_lane')
+    day = request.get('output_end')
+    policy = request.get('refresh_policy')
+    managed = lane in DAILY_LANES and policy == f'extra_{lane}_v6'
+    legacy = include_legacy and lane is None and policy == 'catchup_and_rolling14_calendar_days_v1'
+    if (market is None or task['domain'] != 'prices' or request.get('market') != market
+            or not (managed or legacy)
+            or not isinstance(day, str) or request.get('output_start') != day):
+        return None
+    try:
+        session = date.fromisoformat(day)
+    except ValueError:
+        return None
+    if market == 'KR':
+        return market, task['entity_id'], session, 'KRX', None
+    venue, symbol = request.get('exchange'), request.get('provider_symbol')
+    if request.get('mapping_status') != 'qualified' or venue not in US_VENUES or not symbol:
+        return None
+    return market, task['entity_id'], session, venue, symbol
+
+
+def candidate_price_keys(tasks, ready_dates):
+    keys = set()
+    for task in tasks:
+        if task['status'] not in UNFINISHED:
+            continue
+        key = _request_key(task, include_legacy=True)
+        if (key and key[2] < ready_dates[task['source']]
+                and (market_closed(key[0], key[2])
+                     or (task['status'] in WAITING and task['request'].get('cadence_lane') in DAILY_LANES))):
+            keys.add(key)
+    return keys
+
+
+def stored_price_keys(rows, candidates):
+    """Read positive evidence from verified bundle rows; ignore all other feeds."""
+    observations = {}
+    accepted = {}
+    disputed = set()
+    contracts = {}
+    for row in rows:
+        table, value = row['table'], row['values']
+        if table == 'source_contract' and value['domain'] == 'prices':
+            contracts[value['id']] = value['source'], value['market']
+        elif table == 'selection_decision' and value['record_domain'] == 'price_observation':
+            if value['status'] != 'accepted':
+                disputed.add(value['record_id'])
+            elif value['evidence_grade'] == 'contract_verified':
+                accepted[value['record_id']] = value['rule_version']
+        elif table == 'price_observation' and value['basis'] == 'as_traded':
+            venue, feed = value['venue'], value['feed']
+            market, symbol = None, None
+            if (venue, feed, value['currency']) == ('KRX', 'kis:krx', 'KRW'):
+                market = 'KR'
+            elif venue in US_VENUES and feed == f'kis:us:{venue}' and value['currency'] == 'USD':
+                market, symbol = 'US', value['evidence'].get('source_symbol')
+            key = market, value['security_id'], value['session'], venue, symbol
+            if key in candidates:
+                observations[value['id']] = key, value['source_contract_id']
+    routes = {'KR': ('kis', 'raw_price_structure_v1'),
+              'US': ('kis_overseas', 'kis_overseas_raw_price_structure_v1')}
+    proven = set()
+    for identity, (key, contract) in observations.items():
+        market = key[0]
+        source, rule = routes[market]
+        if (identity not in disputed and accepted.get(identity) == rule
+                and contracts.get(contract) == (source, market)):
+            proven.add(key)
+    return proven
+
+
+def _closure_conflicts(evidence):
+    return any(evidence.get(field) for field in (
+        'normalized_rows_total', 'source_rows_total', 'source_row_count', 'inserted',
+        'rejected', 'rejected_total', 'next_page_token', 'cursor_end', 'last_completed_page',
+        'last_completed_date',
+    ))
+
+
+def _duplicate_priority(task):
+    return (task['status'] != 'succeeded', task['status'] not in WAITING, unstarted(task),
+            task['request'].get('cadence_lane') != 'daily_latest', str(task['id']))
+
+
+def reconcile_price_queue(checkpoint, *, ready_dates, stored):
+    """Audit the restored queue and supersede only proven non-work."""
+    fields = ('unfinished', 'eligible', 'weekend', 'holiday', 'duplicate',
+              'removed_weekend', 'removed_holiday', 'removed_duplicate', 'market_closed',
+              'stored_daily_bar', 'conflicting_evidence')
+    stats = {market: {status: dict.fromkeys(fields, 0) for status in UNFINISHED}
+             for market in MARKET_BY_SOURCE.values()}
+    completed, cleaned, job_ids = set(), set(), set()
+    aliases = defaultdict(list)
+    verified_bars = []
+
+    def record(task, status, reason, **evidence):
+        task['status'] = status
+        task['checkpoint'] = {**task['checkpoint'], **evidence, 'reason': reason}
+        cleaned.add(task['identity_hash'])
+        job_ids.add(task['id'])
+
+    for task in checkpoint.get('task_state', ()):
+        source, status = task['source'], task['status']
+        if source not in MARKET_BY_SOURCE:
+            continue
+        counts = stats[MARKET_BY_SOURCE[source]].get(status)
+        if counts is not None:
+            counts['unfinished'] += 1
+        elif status != 'succeeded' or not task['checkpoint'].get('normalized_rows_total'):
+            continue
+        key = _request_key(task, include_legacy=True)
+        if key is None or key[2] >= ready_dates[source]:
+            continue
+        if counts is None:
+            if not market_closed(key[0], key[2]):
+                aliases[daily_request_identity(task)].append(task)
+            continue
+        counts['eligible'] += 1
+        if market_closed(key[0], key[2]):
+            category = 'weekend' if key[2].weekday() >= 5 else 'holiday'
+            counts[category] += 1
+            if key in stored or _closure_conflicts(task['checkpoint']):
+                counts['conflicting_evidence'] += 1
+                continue
+            record(task, 'superseded', 'verified_exchange_closed')
+            counts[f'removed_{category}'] += 1
+            counts['market_closed'] += 1
+            continue
+        aliases[daily_request_identity(task)].append(task)
+        if key in stored and status in WAITING and task['request'].get('cadence_lane') in DAILY_LANES:
+            verified_bars.append((task, counts))
+
+    for group in aliases.values():
+        if len(group) < 2:
+            continue
+        survivor, *redundant = sorted(group, key=_duplicate_priority)
+        for task in redundant:
+            counts = stats[MARKET_BY_SOURCE[task['source']]].get(task['status'])
+            if counts is None:
+                continue
+            counts['duplicate'] += 1
+            if survivor['status'] in (*WAITING, 'succeeded') and unstarted(task):
+                record(task, 'superseded', 'exact_daily_request_alias')
+                counts['removed_duplicate'] += 1
+
+    for task, counts in verified_bars:
+        if task['status'] in WAITING:
+            record(task, 'succeeded', 'verified_published_daily_bar',
+                   normalized_rows_total=max(1, task['checkpoint'].get('normalized_rows_total') or 0),
+                   source_rows_total=max(1, task['checkpoint'].get('source_rows_total') or 0),
+                   response_valid=True, pagination_valid=True)
+            completed.add(task['identity_hash'])
+            counts['stored_daily_bar'] += 1
+
+    if completed:
+        checkpoint['completed_task_ids'] = sorted(set(checkpoint.get('completed_task_ids', ())) | completed)
+    if cleaned and 'unfinished_task_ids' in checkpoint:
+        checkpoint['unfinished_task_ids'] = [key for key in checkpoint['unfinished_task_ids'] if key not in cleaned]
+    if job_ids and 'price_history_queue' in checkpoint:
+        checkpoint['price_history_queue'] = {
+            source: [job for job in queue if job not in job_ids]
+            for source, queue in checkpoint['price_history_queue'].items()
+        }
+    return stats

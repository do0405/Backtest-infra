+def _verify_bars(payload, symbol, low, high):
+    results = set()
+    bars = payload.get('bars')
+    if not isinstance(bars, dict) or not isinstance(rows := bars.get(symbol, []), list):
+        return results
+    for row in rows:
+        try:
+            stamp = datetime.fromisoformat(row['t'].replace('Z', '+00:00'))
+            if stamp.utcoffset() is None:
+                continue
+            day = stamp.astimezone(ZoneInfo('America/New_York')).date()
+            o, h, l, c, v = (row[field] for field in ('o', 'h', 'l', 'c', 'v'))
+            if (low <= day <= high and not market_closed('US', day)
+                    and all(type(value) in (int, float) and isfinite(value) for value in (o, h, l, c, v))
+                    and 0 < l <= min(o, c) <= max(o, c) <= h and v >= 0):
+                results.add(day)
+        except (AttributeError, KeyError, TypeError, ValueError):
+            continue
+    return results

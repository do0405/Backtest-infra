+def price_backlog_before_resume(tasks, *, previous_sequence, previous_tag):
+    """Summarize the restored price queue without exposing individual requests."""
+    market_by_source = {'kis': 'KR', 'kis_overseas': 'US'}
+    statuses = ('pending', 'retry', 'failed', 'unsupported')
+    by_market = {market: dict.fromkeys(statuses, 0) for market in market_by_source.values()}
+    for task in tasks:
+        status = task['status']
+        if status in statuses:
+            by_market[market_by_source[task['source']]][status] += 1
+    return {
+        'status': 'extra_price_backlog_before_resume',
+        'previous_sequence': previous_sequence,
+        'previous_tag': previous_tag,
+        'unfinished_tasks': sum(sum(counts.values()) for counts in by_market.values()),
+        'by_market': by_market,
+    }

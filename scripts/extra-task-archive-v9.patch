+def _core_manifest(tag, digest, catalog_hash):
+    if not re.fullmatch(r'offline-core-forward-v1-[0-9]{9}', tag):
+        raise ValueError('invalid Core release binding')
+    raw = read(ROOT+tag+'/commit.json', 8*1024**2)
+    if sha256(raw).hexdigest() != digest:
+        raise ValueError('Core published manifest lineage mismatch')
+    commit = json.loads(raw)
+    if commit['catalog_sha256'] != catalog_hash:
+        raise ValueError('Core capture catalog binding mismatch')
+    return commit
+
+
+def _core_state(tag, commit):
+    record = commit['files']['state.json.gz']
+    state_bytes = read(ROOT+tag+'/state.json.gz', record['bytes'])
+    if len(state_bytes) != record['bytes'] or sha256(state_bytes).hexdigest() != record['sha256']:
+        raise ValueError('Core published queue hash mismatch')
+    return json.loads(decompress(state_bytes))
+
+
+def _previous(commit):
+    return commit['previous_tag'], commit['previous_commit_sha256']
+
+
+def _coverage_from(releases, core, windows, eligible, events, *, only_assets=None, baseline=False):
+    candidates, touched = [], set()
+    for tag, commit in releases:
+        groups = defaultdict(list)
+        for item in commit['captures']:
+            if only_assets is not None and (tag,item['asset']) not in only_assets:
+                continue
+            capture = item['capture']
+            identity = capture['entity_id']
+            if capture['source'] != 'alpaca' or identity not in core or identity not in eligible:
+                continue
+            metadata = capture['metadata']
+            row = core[identity]
+            if ((metadata.get('feed'), metadata.get('adjustment'), metadata.get('asof')) != ('sip', 'raw', '-')
+                    or metadata.get('source_member') != row['source_member'] or metadata.get('symbol') != row['symbol']):
+                continue
+            low, high = (date.fromisoformat(metadata[field]) for field in ('start', 'end'))
+            if identity in events:
+                high = min(high, events[identity][2])
+            if (baseline or low <= high) and any(start <= high and low <= end for start, end, _ in windows[identity]):
+                touched.add(identity)
+                groups[item['asset']].append((identity, row['symbol'], low, high, capture['content_sha256']))
+        for asset, rows in groups.items():
+            candidates.append((tag, asset, commit['files'][asset], rows))
+    verified = defaultdict(set)
+    tags, errors, skipped = [], 0, set()
+    remaining = 768*1024**2
+    candidates.sort(key=lambda item: (-len({row[0] for row in item[3]}), item[0], item[1]))
+    for tag, asset, record, rows in candidates:
+        size = record['bytes']
+        if size > remaining:
+            skipped.add((tag,asset))
+            continue
+        remaining -= size
+        try:
+            payload = read(ROOT+tag+'/'+asset, size)
+            if len(payload) != size or sha256(payload).hexdigest() != record['sha256']:
+                raise ValueError('Core asset hash mismatch')
+            groups = defaultdict(list)
+            for identity, symbol, low, high, content_hash in rows:
+                groups[content_hash].append((identity, symbol, low, high))
+            with ZipFile(io.BytesIO(payload)) as archive:
+                for content_hash, captures in groups.items():
+                    content = archive.read('content/'+content_hash+'.bin')
+                    if sha256(content).hexdigest() != content_hash:
+                        raise ValueError('Alpaca payload hash mismatch')
+                    response = json.loads(content)
+                    for identity, symbol, low, high in captures:
+                        verified[identity].update(_verify_bars(response, symbol, low, high))
+            tags.append(tag)
+        except (OSError, ValueError, KeyError, BadZipFile):
+            errors += 1
+    return verified, touched, {'release_count':len(releases), 'read_count':len(tags),
+                               'read_errors':errors,'capped_assets':len(skipped)}, skipped
+

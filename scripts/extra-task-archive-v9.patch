+def _period_counts(windows, verified):
+    complete, partial, any_rows, observed = 0, 0, set(), set()
+    date_windows = {}
+    for identity, ranges in windows.items():
+        if not (bars := verified.get(identity)):
+            continue
+        for start, end, count in ranges:
+            if (start, end) not in date_windows:
+                date_windows[start, end] = {date.fromordinal(n) for n in range(start.toordinal(), end.toordinal()+1)
+                    if not market_closed('US', date.fromordinal(n))}
+            days = date_windows[start, end]
+            if hits := (bars & days):
+                any_rows.add(identity)
+                observed.update(hits)
+                if hits == days:
+                    complete += count
+                else:
+                    partial += count
+    return any_rows, {'securities_with_any_period_bar':len(any_rows),'complete_requests':complete,
+                      'partial_requests':partial, 'observed_start':min(observed).isoformat() if observed else None,
+                      'observed_end':max(observed).isoformat() if observed else None}
+
+
+def _source_causes(state, identities, windows, core, eligible, positions, touched):
+    counts, attempts, source_gaps = Counter(), [], 0
+    for identity in identities:
+        if identity not in eligible:
+            counts['identity_unconfirmed'] += 1
+            continue
+        member = core.get(identity)
+        if not member:
+            counts['outside_core_catalog'] += 1
+            continue
+        def overlaps(record):
+            return bool(record and 'start' in record and 'end' in record
+                        and any(start <= date.fromisoformat(record['end']) and date.fromisoformat(record['start']) <= end
+                                for start, end, _ in windows[identity]))
+        exclusion = state.get('unsupported_symbols', {}).get(identity)
+        gap = state.get('price_gaps', {}).get(identity)
+        pending = ([row for row in gap.get('ranges', []) if overlaps(row)]
+                   if gap and gap['symbol'] == member['symbol'] else [])
+        if pending:
+            source_gaps += 1
+            attempts.extend(row.get('attempts',0) for row in pending)
+        if exclusion and exclusion['symbol'] == member['symbol'] and overlaps(exclusion):
+            counts['supplier_rejected_symbol'] += 1
+        elif pending:
+            reason = gap.get('reason')
+            counts[reason if reason in {'supplier_empty_window','supplier_response_symbol_mismatch',
+                                        'supplier_invalid_symbol'} else 'other_recorded_gap'] += 1
+        elif any(overlaps(cycle) and positions[identity] >= cycle['offset']
+                 for key in ('recent_cycle','cycle') if (cycle:=state.get(key))):
+            counts['awaiting_traversal_in_intersecting_cycle'] += 1
+        elif identity in touched:
+            counts['published_response_no_verified_requested_day'] += 1
+        else:
+            counts['no_overlapping_published_response_or_pending_gap'] += 1
+    return {'reasons':dict(counts),'overlapping_retry_symbols':source_gaps,
+            'retry_attempts_min':min(attempts) if attempts else None,'retry_attempts_max':max(attempts) if attempts else None}
+
+
+def existing_alpaca_coverage(manifest_id, members, windows, verified_listing, events):
+    index = json.loads(read(INDEX, 256*1024))
+    raw = read(ROOT+'offline-core-catalog-v1-20261012/catalog.json', 32*1024**2)
+    catalog_hash = index['catalog_sha256']
+    if sha256(raw).hexdigest() != catalog_hash:
+        raise ValueError('Core catalog hash mismatch')
+    catalog = json.loads(raw)
+    if catalog['manifest_id'] != manifest_id:
+        raise ValueError('Extra and Core original target mismatch')
+    core, positions = {}, {}
+    for pos, row in enumerate(catalog['us_prices']):
+        identity, source = row['entity_id'], row.get('source_member')
+        member = members.get(identity)
+        if (member and source and source['security_id'] == identity and source['identifier'] == member['identifier']
+                and source['symbol'] == member['symbol'] and source['venue'] == member['venue']
+                and row['symbol'] in {member['symbol'], directory_cqs_symbol(source)}):
+            core[identity], positions[identity] = row, pos
+
+    tag, digest = index['tag'], index['commit_sha256']
+    newer = []
+    while tag != CORE_BASE_TAG:
+        if not tag or len(newer) >= 12:
+            raise ValueError('newer Core release bound exceeded')
+        commit = _core_manifest(tag, digest, catalog_hash)
+        newer.append((tag, commit))
+        tag,digest = _previous(commit)
+    if digest != CORE_BASE_DIGEST:
+        raise ValueError('frozen 148 digest mismatch')
+    old = []
+    for _ in range(14):
+        commit = _core_manifest(tag, digest, catalog_hash)
+        old.append((tag, commit))
+        tag,digest = _previous(commit)
+    before, before_touched, scope, skipped = _coverage_from(old, core, windows, verified_listing, events, baseline=True)
+    # The prior 555 result was defined by this exact bound and asset order.
+    # Reproduce it even when the original bound skipped larger assets.
+    print(json.dumps({'status':'alpaca_followup_baseline_scope',**scope}),flush=True)
+    if scope['read_errors']:
+        raise ValueError('frozen baseline evidence could not be read')
+    already, old_counts = _period_counts(windows, before)
+    cohort = set(members) - already
+    if (len(members),len(already),len(cohort)) != (968,555,413):
+        print(json.dumps({'status':'alpaca_followup_baseline_mismatch','cohort_size':len(members),
+                          'baseline_verified':len(already),'unverified':len(cohort)}),flush=True)
+        raise ValueError('exact frozen 413 cohort could not be reproduced')
+    focus = {identity:windows[identity] for identity in cohort}
+    eligible = verified_listing & cohort
+    base_state = _core_state(*old[0])
+    newest_state = _core_state(*newer[0]) if newer else base_state
+    print(json.dumps({'status':'alpaca_followup_baseline','tag':CORE_BASE_TAG,'cohort':len(cohort),
+                      **_source_causes(base_state['sources']['alpaca'],cohort,focus,core,eligible,positions,before_touched)}),flush=True)
+
+    # The original audit used a fourteen-release window. Look separately at
+    # older public evidence and at releases published after that audit.
+    earlier = []
+    for _ in range(26):
+        if not tag:
+            break
+        commit = _core_manifest(tag, digest, catalog_hash)
+        earlier.append((tag, commit))
+        tag,digest = _previous(commit)
+    fresh, fresh_touched, new_scope, _ = _coverage_from(newer,core,focus,eligible,events)
+    deeper, deeper_touched, deep_scope, _ = _coverage_from(earlier,core,focus,eligible,events)
+    missed, missed_touched, missed_scope, _ = _coverage_from(old,core,focus,eligible,events,only_assets=skipped)
+    fresh_ids,fresh_counts = _period_counts(focus,fresh)
+    _,earlier_counts = _period_counts(focus,deeper)
+    _,missed_counts = _period_counts(focus,missed)
+    preexisting = {identity:deeper.get(identity,set()) | missed.get(identity,set()) for identity in cohort}
+    preexisting_ids,preexisting_counts = _period_counts(focus,preexisting)
+    union = {identity:fresh.get(identity,set()) | preexisting[identity] for identity in cohort}
+    found, found_counts = _period_counts(focus,union)
+    still = cohort-found
+    latest = newest_state['sources']['alpaca']
+    progress = {key:{field:latest[key][field] for field in ('start','end','offset') if field in latest[key]}
+                for key in ('recent_cycle','cycle') if latest.get(key)}
+    provider = newest_state.get('provider_status',{}).get('alpaca',{}).get('status')
+    return {'tag':index['tag'],'watermark':latest['watermark'],'provider_status':provider,'cycle_progress':progress,
+            'catalog_members':len(core),'older_archive':{**earlier_counts,**deep_scope,
+              'earliest_scanned':earlier[-1][0] if earlier else None},
+            'newly_published':{**fresh_counts,**new_scope,
+              'first_evidence_not_in_older_archive':len(fresh_ids-preexisting_ids),
+              'tags':[tag for tag,_ in newer]},
+            'baseline_capped_assets':{**missed_counts,**missed_scope},
+            'preexisting_total':preexisting_counts,'total_additional':found_counts,'remaining':len(still),
+            'requested_start':min(start for ranges in focus.values() for start,_,_ in ranges).isoformat(),
+            'requested_end':max(end for ranges in focus.values() for _,end,_ in ranges).isoformat(),
+            'remaining_cause':_source_causes(latest,still,focus,core,eligible,positions,
+                                            before_touched | fresh_touched | deeper_touched | missed_touched)}

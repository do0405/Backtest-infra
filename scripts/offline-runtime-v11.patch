+def _next_dart_instance(item, captures):
+    """Advance one verified accession instance per admitted capture."""
+    if not captures:
+        return []
+    from .contracts import canonical_bytes
+    identity = sha256(canonical_bytes([{'content_sha256': value['content_sha256'],
+        'metadata': value['metadata']} for value, _ in captures])).hexdigest()
+    checkpoint = item.get('dart_instances')
+    index = 0
+    if checkpoint and checkpoint['sha256'] == identity:
+        index = checkpoint['next']
+    if type(index) is not int or not 0 <= index < len(captures):
+        raise ValueError('invalid OpenDART instance checkpoint')
+    if index + 1 == len(captures):
+        item.pop('dart_instances', None)
+    else:
+        item['dart_instances'] = {'sha256': identity, 'next': index + 1}
+    return [captures[index]]
+

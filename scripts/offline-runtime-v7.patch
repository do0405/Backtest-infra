+def _dated_event(member, cqs):
+    event = _NASDAQ_TICKER_EVENTS.get(member.get('security_id'))
+    return event if event and event[0] == cqs == member['symbol'] else None
+
+
+def _cms_symbol(member, cqs):
+    # Only an explicit CQS preferred field can establish the CMS alias.
+    evidence = member.get('evidence', member.get('fields', {}))
+    if evidence.get('CQS Symbol') == cqs and (match := _PREFERRED.fullmatch(cqs)):
+        return f'{match[1]}.PR{match[2]}'
+    return cqs
+
+
+def alpaca_price_routes(member, start, end):
+    """Return disjoint inclusive ISO date ranges and exact Alpaca symbols."""
+    cqs = directory_cqs_symbol(member)
+    event = _dated_event(member, cqs)
+    if event is None:
+        return [(start, end, _cms_symbol(member, cqs))]
+    _, switch, new_symbol, _, _ = event
+    windows = []
+    if start < switch:
+        before = (date.fromisoformat(switch) - timedelta(days=1)).isoformat()
+        windows.append((start, min(end, before), cqs))
+    if end >= switch and new_symbol is not None:
+        windows.append((max(start, switch), end, new_symbol))
+    return windows
